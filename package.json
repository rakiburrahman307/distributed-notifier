{
  "name": "distributed-notifier",
  "version": "1.1.0",
  "description": "Production-grade distributed notification engine for Node.js and TypeScript. Multi-channel delivery across Push (FCM/APNs), Email, SMS, In-App WebSockets, and Webhooks with BullMQ, Redis idempotency, rate limiting, and fallback routing.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-force-exit tests/**/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rakiburrahman307/distributed-notifier.git"
  },
  "bugs": {
    "url": "https://github.com/rakiburrahman307/distributed-notifier/issues"
  },
  "homepage": "https://github.com/rakiburrahman307/distributed-notifier#readme",
  "keywords": [
    "notification",
    "notifications",
    "notification-engine",
    "notification-system",
    "distributed-notifier",
    "distributed-systems",
    "system-design",
    "push-notifications",
    "email-notifications",
    "sms-notifications",
    "in-app-notifications",
    "webhooks",
    "fcm",
    "apns",
    "bullmq",
    "redis",
    "rate-limiter",
    "circuit-breaker",
    "dead-letter-queue",
    "queue",
    "idempotency",
    "traffic-shaper",
    "token-bucket",
    "novu-alternative",
    "courier-alternative",
    "knock-alternative",
    "message-queue",
    "nodejs-notification-system",
    "typescript"
  ],
  "author": {
    "name": "Md Rakibur Rahman",
    "email": "rakiburrahman.dev@gmail.com",
    "url": "https://www.linkedin.com/in/iamrakiburrahman/"
  },
  "license": "MIT",
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "bullmq": "^6.3.15",
    "ioredis": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "bullmq": ">=5.0.0",
    "ioredis": ">=5.3.0"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  }
}
