{
  "name": "distributed-notifier",
  "version": "1.1.0",
  "description": "Production-grade, distributed notification engine supporting multi-channel delivery, dual in-memory/BullMQ queues, smart fallbacks, rate limiting, deduplication, and digest batching.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-force-exit tests/**/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rakiburrahman307/distributed-notifier.git"
  },
  "bugs": {
    "url": "https://github.com/rakiburrahman307/distributed-notifier/issues"
  },
  "homepage": "https://github.com/rakiburrahman307/distributed-notifier#readme",
  "keywords": [
    "notification",
    "distributed-systems",
    "system-design",
    "push-notification",
    "fcm",
    "sms",
    "bullmq",
    "rate-limiter",
    "queue",
    "idempotency"
  ],
  "author": "Md Rakibur Rahman",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "bullmq": "^6.3.15",
    "ioredis": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "bullmq": ">=5.0.0",
    "ioredis": ">=5.3.0"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  }
}
